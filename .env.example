# 复制为 .env.local，填入自己的凭证后重启服务。空值仍可管理项目、GCJ-02 点位和线路草稿。
# 高德 Web 服务 Key：普通驾车规划 2.0 与 WGS84 坐标转换，仅由服务端使用。
AMAP_WEB_SERVICE_KEY=
# 高德 JavaScript API 2.0 Key：浏览器地图、地点搜索；此 Key 会发送到浏览器。
AMAP_JS_KEY=
# 与 JS Key 配套的安全密钥：留在服务端，通过受控同源代理使用。
AMAP_JS_SECURITY_CODE=
# 相对于启动目录，或填写绝对路径；更换该路径相当于打开另一个数据库。
ZHONGTU_DB_PATH=./data/zhongtu.sqlite
