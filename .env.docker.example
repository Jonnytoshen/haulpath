# 复制为 .env.docker，并始终使用 docker compose --env-file .env.docker。
# 修改后须重新创建容器（up -d --force-recreate），restart 不会更新环境变量。
# 宿主机仅绑定 127.0.0.1；只调整端口，不改变本机访问边界。
HAULPATH_PORT=3000
# 可选本地镜像名称，用于升级前保留旧镜像或手动回退；不从 registry 拉取。
HAULPATH_IMAGE=haulpath:local
# 高德配置在运行时注入；空值仍可管理项目、GCJ-02 点位、草稿和导出。
AMAP_WEB_SERVICE_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
# 数据库固定为容器内 /app/data/haulpath.sqlite，整个目录由具名卷持久化。
# 不将宿主机 HAULPATH_DB_PATH 填入此文件。
