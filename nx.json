{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "release": {
    "projects": [
      "haulpath"
    ],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}",
      "strictPreid": true,
      "checkAllBranchesWhen": false
    },
    "conventionalCommits": {
      "useCommitScope": false,
      "types": {
        "feat": {
          "semverBump": "minor",
          "changelog": {
            "title": "Features",
            "hidden": false
          }
        },
        "fix": {
          "semverBump": "patch",
          "changelog": {
            "title": "Bug Fixes",
            "hidden": false
          }
        },
        "perf": {
          "semverBump": "patch",
          "changelog": {
            "title": "Performance Improvements",
            "hidden": false
          }
        },
        "refactor": {
          "semverBump": "none",
          "changelog": {
            "title": "Code Refactoring",
            "hidden": false
          }
        },
        "docs": {
          "semverBump": "none",
          "changelog": {
            "title": "Documentation",
            "hidden": false
          }
        },
        "build": {
          "semverBump": "none",
          "changelog": {
            "title": "Build System",
            "hidden": false
          }
        },
        "ci": {
          "semverBump": "none",
          "changelog": {
            "title": "Continuous Integration",
            "hidden": false
          }
        },
        "test": {
          "semverBump": "none",
          "changelog": {
            "title": "Tests",
            "hidden": false
          }
        },
        "chore": {
          "semverBump": "none",
          "changelog": {
            "title": "Chores",
            "hidden": false
          }
        },
        "style": {
          "semverBump": "none",
          "changelog": {
            "title": "Styles",
            "hidden": false
          }
        },
        "revert": {
          "semverBump": "none",
          "changelog": {
            "title": "Reverts",
            "hidden": false
          }
        }
      }
    },
    "version": {
      "currentVersionResolver": "git-tag",
      "specifierSource": "conventional-commits",
      "adjustSemverBumpsForZeroMajorVersion": true
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": false,
        "renderOptions": {
          "applyUsernameToAuthors": false
        }
      },
      "projectChangelogs": false
    },
    "git": {
      "commit": true,
      "tag": true,
      "push": false,
      "commitMessage": "chore: release v{version}"
    }
  }
}
