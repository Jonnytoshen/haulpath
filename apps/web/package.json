{
  "name": "@haulpath/web",
  "private": true,
  "dependencies": {
    "@haulpath/domain": "workspace:*",
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "6.0.0",
    "tailwind-merge": "^3.7.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "command": "node scripts/next.mjs dev",
          "cwd": "{workspaceRoot}"
        }
      },
      "start": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "command": "node scripts/next.mjs start",
          "cwd": "{workspaceRoot}"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "command": "node scripts/next.mjs build",
          "cwd": "{workspaceRoot}"
        },
        "dependsOn": [
          "^typecheck"
        ]
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "command": "node scripts/next.mjs typecheck",
          "cwd": "{workspaceRoot}"
        },
        "dependsOn": [
          "^typecheck"
        ]
      }
    }
  }
}
