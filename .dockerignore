# Only application inputs enter the build context. Local credentials and data
# stay outside every image layer, including intermediate build stages.
**
!Dockerfile
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!nx.json
!tsconfig.base.json
!apps/web/package.json
!apps/web/next.config.ts
!apps/web/next-env.d.ts
!apps/web/tsconfig.json
!apps/web/postcss.config.mjs
!apps/web/src/**
!apps/web/public/**
!packages/domain/package.json
!packages/domain/tsconfig.json
!packages/domain/src/**
!scripts/workspace.mjs
!scripts/workspace-environment.mjs
!scripts/process.mjs
!scripts/next.mjs
!scripts/next-command.mjs
!scripts/docker/**
**/.env*
**/node_modules/
**/.next/
**/.nx/
**/dist/
**/*.tsbuildinfo
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.db-*
