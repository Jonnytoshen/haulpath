{
  "name": "haulpath",
  "version": "0.1.0",
  "private": true,
  "description": "重途·HaulPath：面向个人规划者的本机工作台，按项目管理重卡业务的行前线路、点位与里程测算。",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "prepare": "husky",
    "test:commits": "node --test tests/commits.test.mjs",
    "commitlint": "node scripts/commitlint.mjs --strict",
    "typecheck": "next typegen && tsc --noEmit",
    "test:api": "node --test --test-concurrency=1 tests/foundation.test.mjs tests/coordinates.test.mjs tests/configuration.test.mjs tests/map-proxy.test.mjs tests/planning.test.mjs tests/planning-recovery.test.mjs tests/import.test.mjs tests/export.test.mjs tests/backup.test.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/workbench.test.mjs tests/acceptance.test.mjs tests/planning-recovery.test.mjs"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/read": "20.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
