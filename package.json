{
  "name": "haulpath",
  "version": "0.2.0",
  "private": true,
  "description": "重途·HaulPath：面向个人规划者的本机工作台，按项目管理重卡业务的行前线路、点位与里程测算。",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "node scripts/workspace.mjs dev",
    "build": "node scripts/workspace.mjs build",
    "start": "node scripts/workspace.mjs start",
    "prepare": "husky",
    "test:commits": "node scripts/workspace.mjs test:commits",
    "commitlint": "node scripts/commitlint.mjs --strict",
    "typecheck": "node scripts/workspace.mjs typecheck",
    "test:api": "node scripts/workspace.mjs test:api",
    "test": "node scripts/workspace.mjs test",
    "test:docker": "node scripts/test-docker.mjs",
    "test:browser": "node scripts/workspace.mjs test:browser",
    "release": "node scripts/workspace.mjs release",
    "test:release": "node scripts/workspace.mjs test:release",
    "release:resume": "node scripts/workspace.mjs release:resume",
    "test:workspace": "node scripts/workspace.mjs test:workspace"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/read": "20.5.0",
    "@nx/js": "24.0.0",
    "husky": "^9.1.7",
    "nx": "24.0.0",
    "playwright": "1.62.1",
    "semver": "7.7.4",
    "typescript": "^6.0.3",
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "@next/env": "16.4.2"
  },
  "nx": {
    "includedScripts": [],
    "implicitDependencies": [
      "@haulpath/web",
      "@haulpath/domain"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "command": "node --test --test-concurrency=1 tests/*.test.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "test-api": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "command": "node --test --test-concurrency=1 tests/foundation.test.mjs tests/coordinates.test.mjs tests/configuration.test.mjs tests/map-proxy.test.mjs tests/planning.test.mjs tests/planning-recovery.test.mjs tests/import.test.mjs tests/export.test.mjs tests/backup.test.mjs tests/workspace-runtime.test.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "test-browser": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "command": "node --test --test-concurrency=1 tests/workbench.test.mjs tests/resources.test.mjs tests/project-refresh.test.mjs tests/overview.test.mjs tests/overview-map.test.mjs tests/overview-map-acceptance.test.mjs tests/overview-concurrency.test.mjs tests/acceptance.test.mjs tests/planning-recovery.test.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "test-commits": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "command": "node --test tests/commits.test.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "test-release": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "command": "node --test --test-concurrency=1 tests/release*.test.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "release": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "command": "node scripts/release-command.mjs release",
          "cwd": "{workspaceRoot}"
        }
      },
      "release-resume": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "command": "node scripts/release-command.mjs release:resume",
          "cwd": "{workspaceRoot}"
        }
      },
      "test-workspace": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "command": "node --test --test-concurrency=1 tests/workspace*.test.mjs",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  }
}
